  {
    "taskId": "snake",
    "required": [
      { "testId": "game-board" },
      { "testId": "game-score" },
      { "testId": "game-restart" }
    ],
    "scenarios": [
      {
        "name": "Игровое поле реагирует на управление",
        "actions": [{ "type": "press", "key": "ArrowRight" }],
        "expect": [{ "type": "changed", "testId": "game-board", "state": "visual" }]
      }
    ]
  },
  {
    "taskId": "calculator",
    "required": [
      { "testId": "calculator-display" },
      { "testId": "calculator-key", "minimum": 10 },
      { "testId": "calculator-equals" },
      { "testId": "calculator-clear" }
    ],
    "scenarios": [
      {
        "name": "Калькулятор выполняет сложение",
        "actions": [
          { "type": "click", "selector": "[data-value=\"2\"]" },
          { "type": "click", "selector": "[data-operation=\"add\"]" },
          { "type": "click", "selector": "[data-value=\"3\"]" },
          { "type": "click", "testId": "calculator-equals" }
        ],
        "expect": [
          { "type": "matches", "testId": "calculator-display", "pattern": "(^|\\D)5(?:[.,]0+)?$" }
        ]
      }
    ]
  },
  {
    "taskId": "chess",
    "required": [
      { "testId": "chess-board" },
      { "testId": "chess-cell", "minimum": 64 },
      { "testId": "chess-piece", "minimum": 2 },
      { "testId": "movable-piece" }
    ],
    "scenarios": [
      {
        "name": "Выбор фигуры подсвечивает допустимые ходы",
        "actions": [{ "type": "click", "testId": "movable-piece" }],
        "expect": [{ "type": "increased", "testId": "available-move", "state": "count" }]
