[
  {
    "taskId": "book-sorting",
    "required": [
      { "testId": "book-card", "minimum": 3 },
      { "testId": "sort-title" },
      { "testId": "sort-price" },
      { "testId": "sort-rating" },
      { "testId": "sort-direction" }
    ],
    "scenarios": [
      {
        "name": "Сортировка по названию изменяет состояние списка",
        "actions": [{ "type": "click", "testId": "sort-title" }],
        "expect": [
          {
            "type": "changed",
            "testId": "sort-title",
            "state": "attribute",
            "attribute": "aria-pressed"
          },
          { "type": "changed", "testId": "sort-direction" }
        ]
      }
    ]
  },
