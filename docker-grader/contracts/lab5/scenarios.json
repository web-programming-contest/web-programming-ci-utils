  {
    "taskId": "movie-booking",
    "required": [
      { "testId": "movie-card" },
      { "testId": "booking-form" },
      { "testId": "booking-submit" },
      { "testId": "booking-confirmation", "visible": false }
    ],
    "scenarios": [
      {
        "name": "Валидная форма показывает подтверждение",
        "prepare": [
          { "type": "fill", "testId": "booking-name", "value": "CI Student" },
          { "type": "fill", "testId": "booking-email", "value": "ci@example.com" },
          { "type": "fill", "testId": "booking-phone", "value": "+79991234567" }
        ],
        "actions": [{ "type": "click", "testId": "booking-submit" }],
        "expect": [{ "type": "visible", "testId": "booking-confirmation" }]
