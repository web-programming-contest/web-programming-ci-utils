{
  "page": "/index.html",
  "titlePattern": "\\S",
  "meaningfulSelector": "main, nav, form, article, section, button, input, textarea, select, canvas, [role]",
  "overflowTolerance": 2,
  "application": {
    "listSelector": "[data-testid=\"entity-list\"]",
    "formSelector": "form[data-testid=\"entity-form\"]",
    "cardSelector": "[data-testid=\"entity-card\"]",
    "deleteSelector": "[data-testid=\"delete-entity\"]",
    "asyncTimeoutMs": 5000
  }
}
