{
  "taskId": "pairs-with-sum",
  "cases": [
    {
      "name": "two distinct pairs",
      "args": [[1, 2, 3, 4, 5], 6],
      "assertion": "pairs-unordered",
      "expected": [
        [1, 5],
        [2, 4]
      ]
    },
    {
      "name": "negative values",
      "args": [[-3, -1, 0, 1, 3, 4], 0],
      "assertion": "pairs-unordered",
      "expected": [
        [-3, 3],
        [-1, 1]
      ]
    },
    { "name": "no pairs", "args": [[1, 2, 3], 20], "assertion": "pairs-unordered", "expected": [] }
  ]
}
