{
  "taskId": "zip-arrays",
  "cases": [
    {
      "name": "two equal arrays",
      "args": [
        [1, 2],
        ["a", "b"]
      ],
      "expected": [
        [1, "a"],
        [2, "b"]
      ]
    },
    {
      "name": "three equal arrays",
      "args": [
        [1, 2],
        ["a", "b"],
        [true, false]
      ],
      "expected": [
        [1, "a", true],
        [2, "b", false]
      ]
    },
    { "name": "empty arrays", "args": [[], []], "expected": [] }
  ]
}
