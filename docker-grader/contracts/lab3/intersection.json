{
  "taskId": "intersection",
  "cases": [
    {
      "name": "common numbers",
      "args": [
        [1, 2, 3, 4],
        [2, 4, 5]
      ],
      "assertion": "unordered",
      "expected": [2, 4]
    },
    {
      "name": "different input order",
      "args": [
        [3, 2, 1],
        [1, 3]
      ],
      "assertion": "unordered",
      "expected": [1, 3]
    },
    {
      "name": "strings",
      "args": [
        ["a", "b", "c"],
        ["b", "a"]
      ],
      "assertion": "unordered",
      "expected": ["a", "b"]
    },
    {
      "name": "no intersection",
      "args": [
        [1, 2],
        [3, 4]
      ],
      "assertion": "unordered",
      "expected": []
    }
  ]
}
