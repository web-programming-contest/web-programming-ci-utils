    { "name": "password fields", "selector": "form input[type='password']", "count": 2 },
    { "name": "birth date", "selector": "form input[type='date']", "count": 1 },
    { "name": "country", "selector": "form select", "count": 1 },
    { "name": "consent", "selector": "form input[type='checkbox']", "count": 1 },
    {
      "name": "submit",
      "selector": "form button[type='submit'], form input[type='submit']",
      "visible": true,
      "css": { "background-color": "rgb(0, 128, 0)", "color": "rgb(255, 255, 255)" }
    }
  ]
