{
  "taskId": "registration-form",
  "elements": [
    {
      "name": "registration form",
      "selector": "form",
      "visible": true,
      "css": {
        "width": "400px",
        "padding-top": "8px",
        "padding-right": "8px",
        "padding-bottom": "8px",
        "padding-left": "8px"
      }
    },
    { "name": "form controls", "selector": "form input", "minCount": 2 },
    {
      "name": "submit button",
      "selector": "form button, form input[type='submit']",
      "visible": true,
      "css": { "background-color": "rgb(0, 86, 255)" }
    }
  ],
  "interactions": [
    {
      "name": "submit button hover",
      "selector": "form button, form input[type='submit']",
      "action": "hover",
      "css": { "background-color": "rgb(65, 127, 251)" }
    }
  ]
}
