{
  "name": "web-programming-ci-utils",
  "version": "1.0.0",
  "private": true,
  "description": "Trusted CLI and reusable GitHub Actions workflows for grading web-programming submissions",
  "type": "module",
  "engines": {
    "node": "24.19.0"
  },
  "scripts": {
    "gate": "node pr-gate/index.mjs",
    "grade": "node docker-grader/index.mjs",
    "report": "node reports/progress.mjs",
    "setup:browser": "playwright install chromium",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "validate": "npm run format:check && npm run lint"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "esbuild": "0.28.2",
    "eslint": "10.9.1",
    "globals": "17.11.0",
    "html-validate": "11.10.0",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0"
  }
}
